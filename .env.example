# Frontend: only this URL is safe to expose through Vite.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Configure these SERVER values using `npx convex env set NAME VALUE`.
# Never prefix server secrets with VITE_. Do not commit .env.local.
NPC_DECISION_MODE=mock
NPC_DECISION_ENABLED=true
NPC_DIALOGUE_MOCK=true
# New NPC dialogue and memory summaries; UI locale is a separate per-browser choice.
NPC_LANGUAGE=zh-CN
DECISIONS_MODEL=gpt-6-luna
OPENAI_API_KEY=
NPC_DECISION_CONCURRENCY=2
NPC_DECISION_REQUESTS_PER_MINUTE=12
NPC_DECISION_REQUESTS_PER_DAY=500
NPC_DECISION_TIMEOUT_MS=5000
NPC_DECISION_MAX_INPUT_CHARS=12000
NPC_DECISION_MIN_CONFIDENCE=0.55
NPC_DECISION_DAILY_BUDGET_USD=2
# Conservative maximum reservation per attempt; two attempts are reserved.
NPC_DECISION_MAX_COST_USD=0.1
# Verify current official model pricing before enabling paid calls.
# Blank rates disable network calls. These are USD per million tokens.
NPC_DECISION_INPUT_PER_MILLION_USD=
NPC_DECISION_CACHED_INPUT_PER_MILLION_USD=
NPC_DECISION_CACHE_WRITE_PER_MILLION_USD=
NPC_DECISION_OUTPUT_PER_MILLION_USD=
# Only enable on a private local deployment. The upstream app is unauthenticated.
NPC_ALLOW_MODE_CONTROL=false
